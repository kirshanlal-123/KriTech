// Kri Tech - Modern Tech & Dev Resource Hub
// Database Schema with Prisma ORM
// Configured for PostgreSQL / MySQL with full relations for resources, roadmaps, cheat sheets, projects & upvotes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  STUDENT
  CONTRIBUTOR
  ADMIN
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum NodeStatus {
  TO_LEARN
  IN_PROGRESS
  MASTERED
}

enum ResourceType {
  ROADMAP
  CHEATSHEET
  PROJECT
  TOOL
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  username      String         @unique
  name          String?
  avatarUrl     String?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // User relations
  upvotes       Upvote[]
  bookmarks     Bookmark[]
  nodeProgress  UserNodeProgress[]
  createdIdeas  ProjectIdea[]   @relation("UserProjects")
  createdTools  ToolSubmission[]

  @@index([email])
  @@index([username])
}

model Resource {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  description   String
  type          ResourceType
  category      String
  tags          String[]
  url           String?
  upvotesCount  Int            @default(0)
  viewsCount    Int            @default(0)
  isFeatured    Boolean        @default(false)
  isTrending    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Polymorphic or direct relations
  upvotes       Upvote[]
  bookmarks     Bookmark[]
  roadmap       Roadmap?
  cheatSheet    CheatSheet?
  projectIdea   ProjectIdea?
  toolDetails   ToolDetails?

  @@index([type])
  @@index([category])
  @@index([isTrending, upvotesCount])
  @@index([slug])
}

model Upvote {
  id          String    @id @default(cuid())
  userId      String
  resourceId  String
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([resourceId])
  @@index([userId])
}

model Bookmark {
  id          String    @id @default(cuid())
  userId      String
  resourceId  String
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
}

model Roadmap {
  id            String    @id @default(cuid())
  resourceId    String    @unique
  title         String
  slug          String    @unique
  description   String
  category      String    // e.g. "Web Development", "Systems", "AI/ML", "DevOps"
  estimatedHours Int      @default(80)
  difficulty    Difficulty @default(INTERMEDIATE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  resource      Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  nodes         Node[]

  @@index([category])
}

model Node {
  id              String             @id @default(cuid())
  roadmapId       String
  title           String
  description     String
  orderIndex      Int
  categoryGroup   String             // Stage name e.g. "Phase 1: Foundations"
  docUrl          String?
  videoUrl        String?
  videoDuration   String?
  estimatedHours  Int                @default(5)
  prerequisites   String[]
  topics          String[]

  roadmap         Roadmap            @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  userProgress    UserNodeProgress[]

  @@index([roadmapId, orderIndex])
}

model UserNodeProgress {
  id          String      @id @default(cuid())
  userId      String
  nodeId      String
  status      NodeStatus  @default(TO_LEARN)
  notes       String?
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  node        Node        @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId, status])
}

model CheatSheet {
  id            String     @id @default(cuid())
  resourceId    String     @unique
  title         String
  technology    String     // e.g. "Python", "Docker", "PostgreSQL", "C", "TypeScript"
  category      String     // "Languages", "Databases", "Bundlers & Tools", "APIs", "DevOps"
  summary       String
  codeSnippets  Json       // Array of { title, language, code, explanation }
  cheatsheetUrl String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  resource      Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([technology])
  @@index([category])
}

model ProjectIdea {
  id              String      @id @default(cuid())
  resourceId      String      @unique
  authorId        String?
  title           String
  difficulty      Difficulty  @default(INTERMEDIATE)
  domain          String      // "Full-Stack", "Systems", "AI/ML", "Mobile", "Security"
  objective       String
  techStack       String[]
  features        String[]
  architecture    String
  suggestedApis   String[]
  estimatedWeeks  Int         @default(3)
  githubStarter   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  resource        Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  author          User?       @relation("UserProjects", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([difficulty])
  @@index([domain])
}

model ToolDetails {
  id            String     @id @default(cuid())
  resourceId    String     @unique
  name          String
  tagline       String
  category      String     // "AI Coding", "API & Backend", "Frontend & UI", "DevOps & Cloud", "Database Tools"
  pricingModel  String     // "Free", "Freemium", "Open Source", "Paid"
  websiteUrl    String
  repoUrl       String?
  tags          String[]
  createdAt     DateTime   @default(now())

  resource      Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([category])
}

model ToolSubmission {
  id          String    @id @default(cuid())
  userId      String?
  name        String
  url         String
  category    String
  description String
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}
